# A sample upstream plus the proxy in front of it, one container, one port, no configuration.
# The real image is `Dockerfile`. This one exists so a directory crawler can start an image and get
# a real answer to tools/list; see examples/demo_container.py. Do not deploy it: it trusts a
# principal header it sets for itself.
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS build
WORKDIR /app
# .pyc at build time: the venv is root-owned, so the process (uid 65532) could never write them
ENV UV_COMPILE_BYTECODE=1
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable

FROM python:3.12-slim-bookworm
COPY --from=build /app/.venv /app/.venv
ENV PATH=/app/.venv/bin:$PATH
# the slim image ships the stdlib without .pyc too; as root, before USER, for the same reason
RUN python -m compileall -q /usr/local/lib/python3.12
COPY tests/fake_upstream.py policy.example.yaml examples/demo_container.py /app/demo/
RUN mkdir /data && chown 65532:65532 /data
WORKDIR /data
USER 65532:65532
EXPOSE 9000
# python, not curl (the image has none). -I keeps /data and PYTHON* env off the import path.
# No proxy: HTTP_PROXY would route 127.0.0.1 through it.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --start-interval=1s --retries=3 \
  CMD ["python", "-I", "-c", "import urllib.request as u; u.build_opener(u.ProxyHandler({})).open('http://127.0.0.1:9000/healthz', timeout=4)"]
ENTRYPOINT ["python", "/app/demo/demo_container.py"]
